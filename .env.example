DATABASE_URI=postgres://careguide:careguide@localhost:5433/careguide
PAYLOAD_SECRET=replace-with-a-long-random-string

# Production-only (Vercel deployment). Leave unset for local development —
# Media uploads then fall back to local disk automatically (see payload.config.ts).
# BLOB_READ_WRITE_TOKEN is created automatically when you add a Vercel Blob store
# to the project and is injected into the deployment; you normally don't set it
# by hand. See docs/DEPLOYMENT.md.
# BLOB_READ_WRITE_TOKEN=
