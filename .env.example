DATABASE_URI=postgres://careguide:careguide@localhost:5433/careguide
PAYLOAD_SECRET=replace-with-a-long-random-string

# Production-only (Vercel deployment). Leave unset for local development.
# Both are created automatically by Vercel's Postgres/Blob integrations and
# injected into the deployment; you normally don't set them by hand.
# See docs/DEPLOYMENT.md.
#
# Media uploads fall back to local disk automatically when unset (see payload.config.ts).
# BLOB_READ_WRITE_TOKEN=
#
# payload.config.ts uses DATABASE_URI if set, otherwise falls back to DATABASE_URL
# (the name Vercel's Postgres/Neon integration uses).
# DATABASE_URL=
